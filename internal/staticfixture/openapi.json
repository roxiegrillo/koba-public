{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Standard error envelope emitted by the koba HTTP adapter.",
        "properties": {
          "error": {
            "description": "Lowercase HTTP status name with spaces replaced by underscores.",
            "type": "string"
          },
          "message": {
            "description": "Human-readable explanation of the failure.",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code returned by the transport.",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "error",
          "message"
        ],
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.Configuration": {
        "properties": {
          "attributes": {
            "additionalProperties": {},
            "type": "object"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.Tag"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.Request": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.Response": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.Tag": {
        "properties": {
          "details": {
            "$ref": "#/components/schemas/github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.TagDetails"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.TagDetails": {
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.WebSocketInput.connectStaticFixture.Y29ubmVjdFN0YXRpY0ZpeHR1cmU.ClientToServer": {
        "description": "Message accepted from the fixture client.",
        "properties": {
          "message": {
            "description": "Client-authored fixture message.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.WebSocketOutput.connectStaticFixture.Y29ubmVjdFN0YXRpY0ZpeHR1cmU.ServerToClient": {
        "description": "Message delivered by the fixture server.",
        "properties": {
          "id": {
            "description": "Stable fixture response identifier.",
            "format": "fixture-id",
            "type": "string"
          },
          "message": {
            "description": "Echoed fixture message.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "message"
        ],
        "type": "object"
      },
      "github.com_roxiegrillo_koba_v2_types.ProbeStatus": {
        "description": "Status returned by the framework-owned operational probes.",
        "properties": {
          "status": {
            "description": "One of ok, ready, or not_ready according to the requested probe.",
            "enum": [
              "ok",
              "ready",
              "not_ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
