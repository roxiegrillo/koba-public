          },
          {
            "description": "Page size",
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Trace ID",
            "in": "header",
            "name": "X-Trace-ID",
            "required": true,
            "schema": {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Session ID",
            "in": "cookie",
            "name": "session",
