            },
            "description": "Invalid request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Configure",
        "tags": [
          "static-fixture"
        ]
      }
    },
    "/fixtures/connect": {
      "get": {
        "operationId": "connectStaticFixture",
        "responses": {
          "101": {
            "description": "WebSocket connection established",
            "headers": {
              "Connection": {
                "description": "Upgrade confirmation.",
                "schema": {
                  "enum": [
                    "Upgrade"
                  ],
                  "type": "string"
                }
              },
              "Upgrade": {
                "description": "Selected upgraded protocol.",
                "schema": {
                  "enum": [
                    "websocket"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Connect fixture transport",
        "tags": [
          "static-fixture"
        ],
        "x-websocket": {
          "clientToServer": {
            "$ref": "#/components/schemas/github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.WebSocketInput.connectStaticFixture.Y29ubmVjdFN0YXRpY0ZpeHR1cmU.ClientToServer"
          },
          "encoding": "json",
          "frameType": "text",
          "serverToClient": {
            "$ref": "#/components/schemas/github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.WebSocketOutput.connectStaticFixture.Y29ubmVjdFN0YXRpY0ZpeHR1cmU.ServerToClient"
          }
        }
      }
    },
