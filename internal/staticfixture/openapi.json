    "/fixtures/{id}/compose": {
      "patch": {
        "operationId": "composeStaticFixture",
        "parameters": [
          {
            "description": "Fixture ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Optional page size",
            "in": "query",
            "name": "page_size",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "oneOf": [
                      {
                        "allOf": [
                          {
                            "required": [
                              "lat"
                            ],
                            "type": "object"
                          },
                          {
                            "required": [
                              "lon"
                            ],
                            "type": "object"
                          }
                        ],
                        "type": "object"
                      },
                      {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "lat"
                              ],
                              "type": "object"
                            },
                            {
                              "required": [
                                "lon"
                              ],
                              "type": "object"
                            }
                          ]
                        },
                        "type": "object"
                      }
                    ],
                    "type": "object"
                  },
                  {
                    "anyOf": [
                      {
                        "not": {
                          "anyOf": [
                            {
                              "properties": {
                                "lat": {
                                  "enum": [
                                    null
                                  ],
                                  "format": "double",
                                  "maximum": 90,
                                  "minimum": -90,
                                  "nullable": true,
                                  "type": "number"
                                }
                              },
                              "required": [
                                "lat"
                              ],
                              "type": "object"
                            },
                            {
                              "properties": {
                                "lon": {
                                  "enum": [
                                    null
                                  ],
                                  "format": "double",
                                  "maximum": 180,
                                  "minimum": -180,
                                  "nullable": true,
                                  "type": "number"
                                }
                              },
                              "required": [
                                "lon"
                              ],
                              "type": "object"
                            }
                          ]
                        },
                        "type": "object"
                      },
                      {
                        "not": {
                          "anyOf": [
                            {
                              "properties": {
                                "lat": {
                                  "format": "double",
                                  "maximum": 90,
                                  "minimum": -90,
                                  "type": "number"
                                }
                              },
                              "required": [
                                "lat"
                              ],
                              "type": "object"
                            },
                            {
                              "properties": {
                                "lon": {
                                  "format": "double",
                                  "maximum": 180,
                                  "minimum": -180,
                                  "type": "number"
                                }
                              },
                              "required": [
                                "lon"
                              ],
                              "type": "object"
                            }
                          ]
                        },
                        "type": "object"
                      }
                    ],
                    "type": "object"
                  }
                ],
                "description": "Composition payload.",
                "example": {
                  "details": {
                    "note": "nested fixture"
                  },
                  "name": "fixture"
                },
                "properties": {
                  "details": {
                    "properties": {
                      "note": {
                        "description": "Composition note.",
                        "maxLength": 128,
                        "type": "string"
                      }
                    },
                    "required": [
                      "note"
                    ],
                    "type": "object"
                  },
                  "lat": {
                    "format": "double",
                    "maximum": 90,
                    "minimum": -90,
                    "nullable": true,
                    "type": "number"
                  },
                  "lon": {
                    "format": "double",
                    "maximum": 180,
                    "minimum": -180,
                    "nullable": true,
                    "type": "number"
                  },
                  "name": {
                    "description": "Composition name.",
                    "example": "fixture",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "details",
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "description": "Composition payload.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "description": "Composed fixture identifier.",
                      "example": "fixture-1",
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal server error"
          }
        },
        "summary": "Compose",
        "tags": [
          "static-fixture"
        ]
      }
    },
    "/fixtures/{id}/inspect": {
      "get": {
        "operationId": "inspectStaticFixture",
        "parameters": [
