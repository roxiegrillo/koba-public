    "/fixtures/{id}/compose": {
      "patch": {
        "operationId": "composeStaticFixture",
        "parameters": [
          {
            "description": "Fixture ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Optional page size",
            "in": "query",
            "name": "page_size",
            "schema": {
