                            }
                          },
                          "required": [
                            "code"
                          ],
                          "type": "object"
                        },
                        "kind": {
                          "description": "Tag kind.",
                          "enum": [
                            "system",
                            "user"
                          ],
                          "type": "string"
                        },
                        "name": {
                          "description": "Tag name.",
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "details",
                        "kind",
                        "name"
                      ],
                      "type": "object"
                    },
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/github.com_roxiegrillo_koba_v2_internal_staticfixture_domain.Configuration"
