                    },
                    "description": "Free-form configuration attributes.",
                    "type": "object"
                  },
                  "tags": {
                    "default": [],
                    "description": "Configured tags.",
                    "items": {
                      "description": "Configured tag.",
                      "properties": {
                        "details": {
                          "properties": {
                            "code": {
                              "description": "Nested tag code.",
                              "format": "slug",
